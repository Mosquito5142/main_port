# ---- Turso (libSQL) — ฐานข้อมูลเดียวของแอป ----
# สร้าง DB: turso db create portfolio
# เอา URL:  turso db show portfolio --url
# เอา token: turso db tokens create portfolio
tursourl=libsql://your-db-name.turso.io
tursoToken=your-token-here

# ใช้ชื่อมาตรฐานก็ได้ (แอปอ่านได้ทั้งสองแบบ)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ---- Google Apps Script (ไม่บังคับ) ----
# ใช้เฉพาะปุ่ม "ส่งเข้า Sheet จริง" ในหน้านำเข้าโพย — เขียนแถวเข้า Google Sheet
# ตัวเดียวกับที่ระบบ LineNotify_Watchlist เดิมใช้ยิงแจ้งเตือน LINE
# ถ้าไม่ตั้งค่านี้ ปุ่มจะแจ้งว่ายังไม่ได้ตั้งค่า แต่ฟีเจอร์อื่นในเว็บทำงานปกติ
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# ---- Password gate (บังคับ ไม่งั้นเข้าเว็บไม่ได้เลย) ----
# SITE_PASSWORD = รหัสผ่านที่ต้องกรอกก่อนใช้งานเว็บ ตั้งเป็นอะไรก็ได้ เปลี่ยนได้ทุกเมื่อ
# AUTH_SECRET   = สุ่มสตริงยาว ๆ ไว้เซ็นคุกกี้ล็อกอิน (เช่น: openssl rand -hex 32) ห้ามแชร์
SITE_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string-here

# ---- Gemini (ไม่บังคับ) ----
# ใช้เฉพาะปุ่ม "ขอความเห็นจาก Gemini" ในหน้าวางแผนลงเงิน — AI ทบทวนแผนที่โค้ดคำนวณไว้แล้ว
# ขอคีย์ฟรีที่ https://aistudio.google.com/apikey
# ไม่ตั้งค่านี้ก็ใช้เว็บได้ครบทุกอย่าง แค่ปุ่มนั้นจะแจ้งว่ายังไม่ได้ตั้งค่า
GEMINI_API_KEY=
